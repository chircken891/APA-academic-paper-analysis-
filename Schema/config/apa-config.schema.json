{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APA repository personal answers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "apa-local-config-1.0"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer_language": { "enum": ["question", "en", "zh-CN"] },
        "detail": { "enum": ["adaptive", "concise", "detailed"] },
        "audience": { "enum": ["adaptive", "beginner", "researcher"] }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/definitions/modelChoice"
        },
        "science": {
          "$ref": "#/definitions/modelChoice"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/definitions/modelChoice"
            },
            "methods": {
              "$ref": "#/definitions/modelChoice"
            },
            "results": {
              "$ref": "#/definitions/modelChoice"
            },
            "interpretation": {
              "$ref": "#/definitions/modelChoice"
            },
            "scientific-reading": {
              "$ref": "#/definitions/modelChoice"
            },
            "integration": {
              "$ref": "#/definitions/modelChoice"
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "english-writer": {
              "$ref": "#/definitions/modelChoice"
            },
            "chinese-writer": {
              "$ref": "#/definitions/modelChoice"
            },
            "translation": {
              "$ref": "#/definitions/modelChoice"
            },
            "reading-editor": {
              "$ref": "#/definitions/modelChoice"
            },
            "independent-verifier": {
              "$ref": "#/definitions/modelChoice"
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parse": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "candidates": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_home": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "config_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dispatch"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "dispatch": { "$ref": "#/definitions/hostDispatch" }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_language": {
          "enum": [
            "en",
            "zh-CN"
          ]
        },
        "presentation_mode": {
          "enum": [
            "writer",
            "reading-editor"
          ]
        }
      }
    },
    "writing_skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nature-writing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "nature-polishing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "nature-shared": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "humanizer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "humanizer-zh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "stss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "enabled"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version"
  ],
  "definitions": {
    "modelChoice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "follow-main"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "model"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reasoning_effort": {
              "$ref": "#/definitions/reasoningEffort"
            }
          }
        }
      ]
    },
    "reasoningEffort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "hostDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "model_argument", "effort_argument", "instruction_argument", "task_name_argument", "fresh_context"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "model_argument": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "\\S" }] },
        "effort_argument": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "\\S" }] },
        "instruction_argument": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "task_name_argument": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "\\S" }] },
        "fresh_context": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "value"],
              "properties": {
                "argument": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "value": {}
              }
            }
          ]
        },
        "result_handle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "pattern"],
          "properties": {
            "source": { "const": "text" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        }
      },
      "if": { "properties": { "model_argument": { "type": "null" } } },
      "then": { "properties": { "effort_argument": { "type": "null" } } }
    },
    "hostProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "host", "detected_at", "session", "models", "dispatch", "sources"],
      "properties": {
        "schema_version": { "const": "apa-host-profile-1.0" },
        "host": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "detected_at": { "type": "string", "minLength": 1 },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning_effort"],
          "properties": {
            "model": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "\\S" }] },
            "reasoning_effort": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/reasoningEffort" }] }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "reasoning_efforts"],
            "properties": {
              "model": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "reasoning_efforts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/reasoningEffort" } }
            }
          }
        },
        "dispatch": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/hostDispatch" }] },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session", "models", "dispatch"],
          "properties": {
            "session": { "$ref": "#/definitions/hostEvidenceSource" },
            "models": { "$ref": "#/definitions/hostEvidenceSource" },
            "dispatch": { "$ref": "#/definitions/hostEvidenceSource" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "adapters": { "type": "array", "items": { "$ref": "#/definitions/hostAdapter" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on_demand_reading": { "$ref": "#/definitions/hostCapability" },
            "delegated_diagnostics": { "$ref": "#/definitions/hostCapability" },
            "manual_compaction": { "$ref": "#/definitions/hostCapability" },
            "concise_replies": { "$ref": "#/definitions/hostCapability" },
            "science_recovery": { "$ref": "#/definitions/hostCapability" },
            "threshold_compaction": { "$ref": "#/definitions/hostCapability" }
          }
        }
      }
    },
    "issueLedger": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile_sha256", "entries"],
      "properties": {
        "schema_version": { "const": "apa-setup-issue-ledger-1.0" },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "disposition", "note", "decided_by"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "disposition": { "enum": ["deferred", "declined", "resolved-elsewhere"] },
              "note": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "decided_by": { "const": "user" }
            }
          }
        }
      }
    },
    "hostCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "scope", "evidence", "limitations"],
      "properties": {
        "status": { "enum": ["detected", "blocked", "unsupported", "unknown"] },
        "method": { "type": ["string", "null"] },
        "scope": { "enum": ["current-session", "new-session", "instance", "unknown"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "reference"],
            "properties": {
              "source": { "enum": ["tool-schema", "system-context", "host-config", "host-docs", "local-code", "runtime-log", "installed-software"] },
              "reference": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "achievement": { "$ref": "#/definitions/hostAchievement" },
        "investigation": {
          "type": "object", "additionalProperties": false,
          "required": ["searched"],
          "properties": {
            "searched": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["source", "location", "result", "note"],
                "properties": {
                  "source": { "enum": ["tool-schema", "system-context", "host-config", "runtime-log", "installed-software", "local-code", "host-docs"] },
                  "location": { "type": ["string", "null"] },
                  "result": { "enum": ["found", "absent", "not-applicable"] },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "recovery": {
          "type": "object", "additionalProperties": false,
          "required": ["task_handle_path", "lookup_tool", "lookup_argument", "original_host_accessible"],
          "properties": {
            "task_handle_path": { "type": ["string", "null"] },
            "lookup_tool": { "type": ["string", "null"] },
            "lookup_argument": { "type": ["string", "null"] },
            "original_host_accessible": { "type": ["boolean", "null"] }
          }
        },
        "threshold": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_tokens", "unit", "setting", "formula", "setting_min", "setting_max", "effective_target_verified", "context_window_tokens", "output_reserve_tokens", "headroom_tokens", "retained_tokens", "measurement"],
          "properties": {
            "candidate_tokens": { "type": ["integer", "null"], "minimum": 1 },
            "unit": { "enum": ["tokens", "ratio", "percent", "unknown"] },
            "setting": { "type": ["string", "null"] },
            "formula": { "enum": ["absolute", "window-ratio-bounded", "unknown"] },
            "setting_min": { "type": ["number", "null"], "minimum": 0 },
            "setting_max": { "type": ["number", "null"], "minimum": 0 },
            "effective_target_verified": { "type": ["boolean", "null"] },
            "context_window_tokens": { "type": ["integer", "null"], "minimum": 1 },
            "output_reserve_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "headroom_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "retained_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "measurement": { "type": ["string", "null"] }
          }
        }
      }
    },
    "hostEvidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "reference"],
        "properties": {
          "source": { "enum": ["tool-schema", "system-context", "host-config", "host-docs", "local-code", "runtime-log", "installed-software"] },
          "reference": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "hostAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "host", "root", "entrypoints", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owner": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "host": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "root": { "type": "string", "minLength": 1 },
        "entrypoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/definitions/hostEvidence" }
      }
    },
    "hostAchievement": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "summary", "steps"],
      "properties": {
        "state": { "enum": ["achieved", "needs-setting", "needs-user-action", "needs-apa-change", "not-found"] },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/hostAchievementStep" } }
      }
    },
    "hostAchievementStep": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "instruction", "command", "scope", "persistent", "verify", "evidence"],
      "properties": {
        "actor": { "enum": ["apa", "script", "user"] },
        "instruction": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "command": { "type": ["string", "null"] },
        "scope": { "enum": ["current-session", "new-session", "instance", "project-settings", "user-settings", "unknown"] },
        "persistent": { "type": "boolean" },
        "verify": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": { "$ref": "#/definitions/hostEvidence" },
        "adapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "range": {
          "type": "object", "additionalProperties": false, "required": ["min", "max", "unit"],
          "properties": {
            "min": { "type": ["number", "null"] }, "max": { "type": ["number", "null"] },
            "unit": { "enum": ["tokens", "ratio", "percent"] }
          }
        }
      }
    },
    "hostEvidenceSource": {
      "enum": ["tool-schema", "system-context", "host-config", "host-docs", "unverified", "unavailable"]
    }
  }
}
