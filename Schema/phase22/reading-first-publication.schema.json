{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase22/reading-first-publication-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "identity", "presentation_fingerprint", "scientific_input_fingerprint", "evidence_mode", "dependencies", "qualification", "targets"],
  "properties": {
    "schema_version": { "const": "reading-first-publication-1.0" },
    "profile": { "const": "reading-first-obsidian-1.0" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["paper_id", "run_id", "analysis_revision"],
      "properties": { "paper_id": { "$ref": "#/$defs/text" }, "run_id": { "$ref": "#/$defs/text" }, "analysis_revision": { "$ref": "#/$defs/text" } }
    },
    "presentation_fingerprint": { "$ref": "#/$defs/hash" },
    "scientific_input_fingerprint": { "$ref": "#/$defs/hash" },
    "path_migration": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_generation", "previous_presentation_sha256", "path_mapping_fingerprint"],
      "properties": { "previous_generation": { "$ref": "#/$defs/text" },
        "previous_presentation_sha256": { "$ref": "#/$defs/hash" }, "path_mapping_fingerprint": { "$ref": "#/$defs/hash" } }
    },
    "evidence_mode": { "enum": ["synthetic", "actual"] },
    "dependencies": { "type": "object" },
    "qualification": {
      "type": "object", "required": ["reading_status", "native_status"],
      "properties": { "reading_status": { "const": "reading_complete" }, "native_status": { "const": "not_run" } }
    },
    "targets": {
      "type": "object", "additionalProperties": false, "required": ["presentation", "notes", "support", "assets"],
      "properties": {
        "presentation": { "type": "string", "pattern": "^\\.apa-v3/reading-first/presentation/[^/]+\\.json$" },
        "notes": {
          "type": "object", "additionalProperties": false, "required": ["en", "zh-CN"],
          "properties": { "en": { "$ref": "#/$defs/note" }, "zh-CN": { "$ref": "#/$defs/note" } }
        },
        "support": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["entity_id", "path"],
            "properties": { "entity_id": { "$ref": "#/$defs/text" }, "path": { "type": "string", "pattern": "^Wiki/(methods|concepts)/[^/]+\\.md$" } }
          }
        },
        "assets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(Raw|Figures)/.+" } }
      }
    },
    "navigation": { "type": "array", "items": { "type": "object" } },
    "citation": {
      "type": "object", "additionalProperties": false, "required": ["bibliography", "sources"],
      "properties": {
        "bibliography": { "type": "object" },
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_id", "path", "sha256", "byte_length", "source_version", "locators"],
            "properties": {
              "source_id": { "$ref": "#/$defs/text" },
              "path": { "type": "string", "pattern": "^Raw/.+\\.[pP][dD][fF]$" },
              "sha256": { "$ref": "#/$defs/hash" },
              "byte_length": { "type": "integer", "minimum": 0 },
              "source_version": { "type": ["string", "null"] },
              "locators": {
                "type": "array", "items": {
                  "type": "object", "additionalProperties": false, "required": ["kind", "id", "page", "label"],
                  "properties": {
                    "kind": { "enum": ["figure", "table", "formula"] }, "id": { "$ref": "#/$defs/text" },
                    "page": { "type": "integer", "minimum": 1 }, "label": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "note": {
      "type": "object", "additionalProperties": false, "required": ["path", "managed_hash", "byte_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^Wiki/(sources|translations)/[^/]+\\.md$" },
        "managed_hash": { "$ref": "#/$defs/hash" }, "byte_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
