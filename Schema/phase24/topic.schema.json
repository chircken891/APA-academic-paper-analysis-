            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "statement_locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "replacement_dependency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "paper_id",
                  "analysis_revision",
                  "adopted_generation_id",
                  "source_id",
                  "source_sha256",
                  "source_version",
                  "locators",
                  "adopted_for"
                ],
                "properties": {
                  "paper_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "analysis_revision": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "adopted_generation_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "source_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "locators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id",
                        "page",
                        "label"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "figure",
                            "table",
                            "formula"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "label": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "adopted_for": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
