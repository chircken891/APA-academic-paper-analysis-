    "candidate": {
      "oneOf": [
        {
          "$ref": "#/$defs/topicCandidate"
        },
        {
          "$ref": "#/$defs/sourceChangeCandidate"
        },
        {
          "$ref": "#/$defs/projectCandidate"
        }
      ]
    },
    "encodedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes_base64"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\x00-\\x1f:]+$"
          },
          "bytes_base64": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "options",
        "base",
        "preimages"
      ],
      "properties": {
        "schema_version": {
          "const": "phase24-topic-registration-1.0"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vaultRoot",
            "candidate",
            "operationId"
          ],
          "properties": {
            "vaultRoot": {
              "type": "string",
              "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
            },
            "candidate": {
              "$ref": "#/$defs/candidate"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "generation": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "index",
            "files"
          ],
          "properties": {
            "current_content_policy": {
              "const": "registered-current-1.0"
            },
            "generation": {
              "$ref": "../phase22/active-index-1.0#/$defs/active"
            },
            "index": {
              "$ref": "../phase22/active-index-1.0#/$defs/index"
            },
            "files": {
              "$ref": "#/$defs/encodedFiles"
            }
          }
        },
        "preimages": {
          "$ref": "#/$defs/encodedFiles"
        }
      }
