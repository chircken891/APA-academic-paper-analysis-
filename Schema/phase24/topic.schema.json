        "adopted_generation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
