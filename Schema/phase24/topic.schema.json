    "sourceChangeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "expected_generation_id",
        "event",
        "input_hash",
        "candidate_path",
        "config_fingerprint"
      ],
      "properties": {
        "operation": {
          "const": "source-change"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "expected_generation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "kind",
            "target",
            "target_generation_id",
            "reason",
            "recorded_from",
            "replacement"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "kind": {
              "enum": [
                "correction",
                "replacement",
                "withdrawal"
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "paper_id",
                "analysis_revision",
                "source_id",
                "source_sha256"
              ],
              "properties": {
                "paper_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "analysis_revision": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "target_generation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "recorded_from": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "replacement": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "paper_id",
                    "analysis_revision",
                    "source_id",
                    "source_sha256",
                    "generation_id"
                  ],
                  "properties": {
                    "paper_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "analysis_revision": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "generation_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "replacement"
                  }
                }
              },
              "then": {
                "properties": {
                  "replacement": {
                    "type": "object"
                  }
                }
              },
              "else": {
                "properties": {
                  "replacement": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidate_path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
        },
        "config_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
