{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"phase21/source-evidence-bundle",
  "type":"object","additionalProperties":false,
  "required":["schema_version","bundle_fingerprint","sources","required_coverage","source_coverage","pdf_run","office_observations","source_limits","provenance"],
  "properties":{
    "schema_version":{"const":"phase21-source-evidence-bundle-1.0"},
    "bundle_fingerprint":{"$ref":"whole-paper#/$defs/hash"},
    "sources":{"type":"array","minItems":1,"items":{"$ref":"whole-paper#/$defs/source"}},
    "required_coverage":{"type":"array","minItems":1,"items":{"$ref":"whole-paper#/$defs/coverage"}},
    "source_coverage":{"type":"array","minItems":1,"items":{"$ref":"whole-paper#/$defs/observedCoverage"}},
    "pdf_run":{"type":["object","null"]},
    "office_observations":{"type":"array","items":{"$ref":"whole-paper#/$defs/observation"}},
    "visual_observations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/visualObservation"}},
    "source_limits":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["limit_id","kind","document_id","source_record_ids","reason","original"],"properties":{
      "limit_id":{"$ref":"whole-paper#/$defs/hash"},"kind":{"enum":["unresolved_record","error_record","source_unread","coverage_incomplete","interpretation_unresolved","visibility_withheld","source_error","pdf_error","derived_representation_difference"]},"document_id":{"type":"string"},"source_record_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"reason":{"type":"string","minLength":1},"original":{}
    },"allOf":[{"if":{"properties":{"kind":{"const":"visibility_withheld"}},"required":["kind"]},"then":{"properties":{"original":{"$ref":"#/$defs/visibilityOriginal"}}}}]}},
    "provenance":{"type":"object","additionalProperties":false,"required":["office_sources","pdf_sources","pdf_run_binding","approval_binding","tool_binding","office_method","pdf_method"],"properties":{
      "office_method":{"const":"source_read"},"pdf_method":{"const":"saved_parser_output"},
      "visual_sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/visualSource"}},
      "office_sources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["document_id","source_bytes_base64","source_evidence"],"properties":{"document_id":{"type":"string"},"source_bytes_base64":{"type":"string","minLength":1},"source_evidence":{"type":"object","allOf":[{"if":{"properties":{"format":{"const":"xls"}},"required":["format"]},"then":{"oneOf":[{"$ref":"whole-paper#/$defs/derivedWorkbookEvidence"},{"$ref":"whole-paper#/$defs/originalWorkbookEvidence"}]}}]}}}},
      "pdf_sources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["document_id","source_bytes_base64"],"properties":{"document_id":{"type":"string"},"source_bytes_base64":{"type":"string","minLength":1}}}},
      "pdf_run_binding":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["record_ref","bytes_base64","sha256"],"properties":{"record_ref":{"type":"string","minLength":1},"bytes_base64":{"type":"string","minLength":1},"sha256":{"$ref":"whole-paper#/$defs/hash"}}}]},
      "approval_binding":{"type":"object","additionalProperties":false,"required":["authorization_fingerprint","source_scope_fingerprint","policy_fingerprint"],"properties":{"authorization_fingerprint":{"$ref":"whole-paper#/$defs/hash"},"source_scope_fingerprint":{"$ref":"whole-paper#/$defs/hash"},"policy_fingerprint":{"$ref":"whole-paper#/$defs/hash"}}},
      "tool_binding":{"type":"object","additionalProperties":false,"required":["fingerprint","components"],"properties":{"fingerprint":{"$ref":"whole-paper#/$defs/hash"},"components":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"whole-paper#/$defs/hash"}}}}}}
    }}
  },
  "$defs":{
    "visualObservation":{
      "type":"object","additionalProperties":false,
      "required":["id","origin","document_id","source_sha256","locator","physical_page","region","literal","text","text_derivation","image_sha256","review_sha256","review_case_id","manifest_sha256"],
      "properties":{
        "id":{"type":"string","minLength":1},"origin":{"const":"reviewed_visual_source"},"document_id":{"type":"string","minLength":1},"source_sha256":{"$ref":"whole-paper#/$defs/hash"},
        "locator":{"type":"object","additionalProperties":false,"required":["document_id","page_number","page_status","source_block_id"],"properties":{"document_id":{"type":"string","minLength":1},"page_number":{"type":"integer","minimum":1},"page_status":{"const":"known"},"source_block_id":{"type":"string","minLength":1}}},"physical_page":{"type":"integer","minimum":1},"region":{"type":"string","minLength":1},"literal":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"text_derivation":{"enum":["identity","reviewed_line_join_only"]},
        "image_sha256":{"$ref":"whole-paper#/$defs/hash"},"review_sha256":{"$ref":"whole-paper#/$defs/hash"},"review_case_id":{"type":"string","minLength":1},"manifest_sha256":{"$ref":"whole-paper#/$defs/hash"}
      }
    },
    "visualSource":{
      "type":"object","additionalProperties":false,
      "required":["observation_id","document_id","physical_page","region","literal","text","text_derivation","image","review","manifest"],
      "properties":{
        "observation_id":{"type":"string","minLength":1},"document_id":{"type":"string","minLength":1},"physical_page":{"type":"integer","minimum":1},"region":{"type":"string","minLength":1},"literal":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"text_derivation":{"enum":["identity","reviewed_line_join_only"]},
        "image":{"$ref":"#/$defs/visualImageBinding"},"review":{"$ref":"#/$defs/visualReviewBinding"},"manifest":{"$ref":"#/$defs/visualManifestBinding"}
      }
    },
    "visualImageBinding":{"type":"object","additionalProperties":false,"required":["record_ref","sha256","bytes_base64"],"properties":{"record_ref":{"type":"string","minLength":1},"sha256":{"$ref":"whole-paper#/$defs/hash"},"bytes_base64":{"type":"string","minLength":1}}},
    "visualReviewBinding":{"type":"object","additionalProperties":false,"required":["record_ref","sha256","bytes_base64","case_id"],"properties":{"record_ref":{"type":"string","minLength":1},"sha256":{"$ref":"whole-paper#/$defs/hash"},"bytes_base64":{"type":"string","minLength":1},"case_id":{"type":"string","minLength":1}}},
    "visualManifestBinding":{"type":"object","additionalProperties":false,"required":["record_ref","sha256","bytes_base64","document_key"],"properties":{"record_ref":{"type":"string","minLength":1},"sha256":{"$ref":"whole-paper#/$defs/hash"},"bytes_base64":{"type":"string","minLength":1},"document_key":{"type":"string","minLength":1}}},
    "transformation":{
      "type":"object","additionalProperties":false,
      "required":["transformation_id","document_id","part","part_sha256","xml_path","attribute","source_value_sha256","replacement","reason_code"],
      "properties":{
        "transformation_id":{"$ref":"whole-paper#/$defs/hash"},"document_id":{"type":"string","minLength":1},"part":{"type":"string","minLength":1},"part_sha256":{"$ref":"whole-paper#/$defs/hash"},
        "xml_path":{"type":"string","minLength":1},"attribute":{"enum":["url","SelectedStyle"]},"source_value_sha256":{"$ref":"whole-paper#/$defs/hash"},"replacement":{"type":"string","pattern":"^WITHHELD_[a-f0-9]{64}$"},"reason_code":{"enum":["author_save_path","bibliography_style_path"]}
      }
    },
    "visibilityOriginal":{
      "type":"object","additionalProperties":false,
      "required":["transformation_id","document_id","part","part_sha256","xml_path","attribute","source_value_sha256","replacement","reason_code","policy_version"],
      "properties":{
        "transformation_id":{"$ref":"whole-paper#/$defs/hash"},"document_id":{"type":"string","minLength":1},"part":{"type":"string","minLength":1},"part_sha256":{"$ref":"whole-paper#/$defs/hash"},
        "xml_path":{"type":"string","minLength":1},"attribute":{"enum":["url","SelectedStyle"]},"source_value_sha256":{"$ref":"whole-paper#/$defs/hash"},"replacement":{"type":"string","pattern":"^WITHHELD_[a-f0-9]{64}$"},"reason_code":{"enum":["author_save_path","bibliography_style_path"]},"policy_version":{"const":"phase21-source-visibility-policy-1.0"}
      }
    },
    "visibleView":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","policy_version","source_bundle_fingerprint","source_scope_fingerprint","sources","required_coverage","source_coverage","pdf_evidence","office_observations","office_parts","source_limits","transformations","view_fingerprint"],
      "properties":{
        "schema_version":{"const":"phase21-source-evidence-visible-view-1.0"},"policy_version":{"const":"phase21-source-visibility-policy-1.0"},
        "source_bundle_fingerprint":{"$ref":"whole-paper#/$defs/hash"},"source_scope_fingerprint":{"$ref":"whole-paper#/$defs/hash"},"view_fingerprint":{"$ref":"whole-paper#/$defs/hash"},
        "visual_observations":{"$ref":"#/properties/visual_observations"},
        "sources":{"$ref":"#/properties/sources"},"required_coverage":{"$ref":"#/properties/required_coverage"},"source_coverage":{"$ref":"#/properties/source_coverage"},"office_observations":{"$ref":"#/properties/office_observations"},"source_limits":{"$ref":"#/properties/source_limits"},
        "pdf_evidence":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["blocks","page_coverage","assets","normalization_audit","errors","candidate_eligibility"],"properties":{
          "blocks":{"$ref":"parser-run#/properties/blocks"},"page_coverage":{"$ref":"parser-run#/properties/page_coverage"},"assets":{"$ref":"parser-run#/properties/assets"},"normalization_audit":{"$ref":"parser-run#/properties/normalization_audit"},"errors":{"$ref":"parser-run#/properties/errors"},"candidate_eligibility":{"$ref":"parser-run#/properties/candidate_eligibility"}
        }}]},
        "office_parts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["document_id","part","part_sha256","byte_length","visible_xml"],"properties":{"document_id":{"type":"string","minLength":1},"part":{"type":"string","minLength":1},"part_sha256":{"$ref":"whole-paper#/$defs/hash"},"byte_length":{"type":"integer","minimum":0},"visible_xml":{"type":"string"}}}},
        "transformations":{"type":"array","items":{"$ref":"#/$defs/transformation"}}
      }
    }
  }
}
