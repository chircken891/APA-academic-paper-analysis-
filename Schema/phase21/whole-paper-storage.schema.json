{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"phase21/whole-paper-storage",
  "type":"object","additionalProperties":false,
  "required":["storage_contract","logical_kind","logical_fingerprint","root_node","strings","key_sets","nodes"],
  "properties":{
    "storage_contract":{"enum":["phase21-whole-paper-storage-1.0","phase21-whole-paper-storage-2.0"]},
    "logical_kind":{"enum":["parser_run","accepted_reference","comparison_input","comparison_result","scientific_input","integration_role","source_evidence_bundle","source_evidence_scientific_input","source_evidence_visible_view"]},
    "logical_fingerprint":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "root_node":{"$ref":"#/$defs/index"},
    "strings":{"type":"array","items":{"type":"string"}},
    "key_sets":{"type":"array","items":{"$ref":"#/$defs/indices"}},
    "nodes":{"type":"array","minItems":1,"maxItems":6000000}
  },
  "allOf":[{
    "if":{"properties":{"storage_contract":{"const":"phase21-whole-paper-storage-1.0"}}},
    "then":{"properties":{"nodes":{"maxItems":4000000,"items":{"$ref":"#/$defs/nodeV1"}}}},
    "else":{"properties":{
      "logical_kind":{"enum":["parser_run","comparison_input","comparison_result","source_evidence_bundle","source_evidence_scientific_input","source_evidence_visible_view"]},
      "nodes":{"items":{"$ref":"#/$defs/nodeV2"}}
    },"allOf":[{
      "if":{"properties":{"logical_kind":{"enum":["parser_run","comparison_input","comparison_result"]}}},
      "then":{"properties":{"nodes":{"maxItems":6000000}}},
      "else":{"properties":{"nodes":{"maxItems":4000000}}}
    }]}
  }],
  "$defs":{
    "index":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "indices":{"type":"array","items":{"$ref":"#/$defs/index"}},
    "nodeV1":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"const":"scalar"},"value":{"type":["null","boolean","number"]}}},
      {"type":"object","additionalProperties":false,"required":["type","index"],"properties":{"type":{"const":"string"},"index":{"$ref":"#/$defs/index"}}},
      {"type":"object","additionalProperties":false,"required":["type","children"],"properties":{"type":{"const":"array"},"children":{"$ref":"#/$defs/indices"}}},
      {"type":"object","additionalProperties":false,"required":["type","keys","children"],"properties":{"type":{"const":"object"},"keys":{"$ref":"#/$defs/index"},"children":{"$ref":"#/$defs/indices"}}}
    ]},
    "nodeV2":{"oneOf":[
      {"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"const":0},{"type":["null","boolean","number"]}],"items":false},
      {"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"const":1},{"$ref":"#/$defs/index"}],"items":false},
      {"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"const":2},{"$ref":"#/$defs/indices"}],"items":false},
      {"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"const":3},{"$ref":"#/$defs/index"},{"$ref":"#/$defs/indices"}],"items":false}
    ]}
  }
}
