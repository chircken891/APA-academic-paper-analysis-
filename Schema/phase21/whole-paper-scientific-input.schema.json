{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"phase21/whole-paper-scientific-input",
  "type":"object","additionalProperties":false,
  "required":["schema_version","identity","source_package","core","reading_card","scientific_details","input_fingerprint","source_run","source_value_metadata"],
  "properties":{
    "schema_version":{"const":"phase21-scientific-input-whole-paper-1.0"},"identity":{"$ref":"whole-paper-scientific-details#/$defs/identity"},"source_package":{"$ref":"whole-paper-scientific-source"},"core":{"$ref":"whole-paper-scientific-analysis#/properties/core"},"reading_card":{"$ref":"whole-paper-scientific-analysis#/properties/reading_card"},"scientific_details":{"$ref":"whole-paper-scientific-details#/$defs/details"},"input_fingerprint":{"$ref":"whole-paper#/$defs/hash"},"source_run":{"$ref":"whole-paper#/$defs/run"},"source_value_metadata":{"type":"array","items":{"$ref":"#/$defs/valueMetadata"}}
  },
  "$defs":{
    "docxLocator":{"type":"object","additionalProperties":false,"required":["kind","source_document_id","source_hash","block_id","member_path","part","part_sha256","xml_path"],"properties":{"kind":{"const":"docx"},"source_document_id":{"type":"string","pattern":"^src_[0-9a-f]{32}$"},"source_hash":{"$ref":"whole-paper#/$defs/hash"},"block_id":{"type":"string","pattern":"\\S"},"member_path":{"type":["string","null"]},"part":{"type":"string","minLength":1},"part_sha256":{"$ref":"whole-paper#/$defs/hash"},"xml_path":{"type":"string","pattern":"^/[A-Za-z_][A-Za-z0-9_-]*\\[[1-9][0-9]*\\](?:/[A-Za-z_][A-Za-z0-9_-]*\\[[1-9][0-9]*\\])*$"}}},
    "workbookLocator":{"type":"object","additionalProperties":false,"required":["kind","source_document_id","source_hash","block_id","member_path","sheet","range"],"properties":{"kind":{"const":"workbook"},"source_document_id":{"type":"string","pattern":"^src_[0-9a-f]{32}$"},"source_hash":{"$ref":"whole-paper#/$defs/hash"},"block_id":{"type":"string","pattern":"\\S"},"member_path":{"type":["string","null"]},"sheet":{"type":"object","additionalProperties":false,"required":["index","name"],"properties":{"index":{"type":"integer","minimum":0},"name":{"type":"string","minLength":1}}},"range":{"type":"object","additionalProperties":false,"required":["start_row","start_column","end_row","end_column"],"properties":{"start_row":{"type":"integer","minimum":1},"start_column":{"type":"integer","minimum":1},"end_row":{"type":"integer","minimum":1},"end_column":{"type":"integer","minimum":1}}}}},
    "valueSpan":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1}}},
    "valueCell":{"type":"object","additionalProperties":false,"required":["row","column"],"properties":{"row":{"type":"integer","minimum":1},"column":{"type":"integer","minimum":1}}},
    "valueMetadata":{"type":"object","additionalProperties":false,"required":["kind","source_document_id","locator","original_type","raw_lexical_value","record_fingerprint"],"properties":{"kind":{"enum":["docx","workbook"]},"source_document_id":{"type":"string","pattern":"^src_[0-9a-f]{32}$"},"locator":{"oneOf":[{"$ref":"#/$defs/docxLocator"},{"$ref":"#/$defs/workbookLocator"}]},"original_type":{"type":"string","minLength":1},"raw_lexical_value":{"type":"string"},"record_fingerprint":{"$ref":"whole-paper#/$defs/hash"}}}
