{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase21/source-evidence-scientific-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "source_package",
    "core",
    "reading_card",
    "scientific_details",
    "input_fingerprint",
    "source_evidence_bundle",
    "source_value_metadata",
    "parser_evaluation_disposition"
  ],
  "properties": {
    "schema_version": {
      "const": "phase21-scientific-input-source-evidence-1.0"
    },
    "identity": {
      "$ref": "whole-paper-scientific-details#/$defs/identity"
    },
    "source_package": {
      "$ref": "whole-paper-scientific-source"
    },
    "core": {
      "$ref": "whole-paper-scientific-analysis#/properties/core"
    },
    "reading_card": {
      "$ref": "whole-paper-scientific-analysis#/properties/reading_card"
    },
    "scientific_details": {
      "$ref": "whole-paper-scientific-details#/$defs/details"
    },
    "input_fingerprint": {
      "$ref": "whole-paper#/$defs/hash"
    },
    "source_evidence_bundle": {
      "$ref": "source-evidence-bundle"
    },
    "source_value_metadata": {
      "type": "array",
      "items": {
        "$ref": "whole-paper-scientific-input#/$defs/valueMetadata"
      }
    },
    "parser_evaluation_disposition": {
      "$ref": "#/$defs/disposition"
    }
  },
  "$defs": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_status",
        "comparison_status",
        "source_scope_fingerprint",
        "reason",
        "evidence_records"
      ],
      "properties": {
        "requirement_status": {
          "const": "unmet"
        },
        "comparison_status": {
          "enum": [
            "not_run",
            "not_comparable",
            "rejected"
          ]
        },
        "source_scope_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "record_ref",
              "sha256",
              "bytes_base64"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "admission",
                  "comparison"
                ]
              },
              "record_ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "whole-paper#/$defs/hash"
              },
              "bytes_base64": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scientific_input_fingerprint",
        "source_bundle_fingerprint",
        "obligation_reviews",
        "claim_reviews",
        "quantity_reviews",
        "gap_dispositions"
      ],
      "properties": {
        "schema_version": {
          "const": "phase21-scientific-evidence-review-1.0"
        },
        "scientific_input_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "source_bundle_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "obligation_reviews": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "semantic_unit_id",
              "verdict",
              "source_block_ids",
              "reason"
            ],
            "properties": {
              "semantic_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "bounded",
                  "blocked"
                ]
              },
              "source_block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "claim_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "record_ids",
              "source_block_ids",
              "allowed_conclusion",
              "forbidden_stronger_interpretation",
              "verdict",
              "reason"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_block_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "allowed_conclusion": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_stronger_interpretation": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "bounded",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "quantity_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity_id",
              "source_occurrences_fingerprint",
              "verdict",
              "reason",
              "context_checks"
            ],
            "properties": {
              "quantity_id": {
                "type": "string",
                "minLength": 1
              },
              "source_occurrences_fingerprint": {
                "$ref": "whole-paper#/$defs/hash"
              },
              "verdict": {
                "enum": [
                  "supported",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "context_checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric_definition",
                  "unit",
                  "denominator",
                  "groups",
                  "timepoint",
                  "analysis_set",
                  "raw_precision",
                  "uncertainty"
                ],
                "properties": {
                  "metric_definition": {
                    "type": "boolean"
                  },
                  "unit": {
                    "type": "boolean"
                  },
                  "denominator": {
                    "type": "boolean"
                  },
                  "groups": {
                    "type": "boolean"
                  },
                  "timepoint": {
                    "type": "boolean"
                  },
                  "analysis_set": {
                    "type": "boolean"
                  },
                  "raw_precision": {
                    "type": "boolean"
                  },
                  "uncertainty": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "gap_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gap_id",
              "origin",
              "record_ids",
              "claim_ids",
              "quantity_ids",
              "disposition",
              "reason"
            ],
            "properties": {
              "gap_id": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "enum": [
                  "source_limit",
                  "inventory"
                ]
              },
              "record_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "quantity_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "disposition": {
                "enum": [
                  "bounded_limit",
                  "blocks_use"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "scientific_input_fingerprint",
        "source_bundle_fingerprint",
        "source_check_receipt_sha256",
        "review_fingerprint",
        "parser_evaluation_disposition_fingerprint",
        "parser_evaluation_requirement_satisfied",
        "scientific_completeness",
        "bounded_limits",
        "qualification_fingerprint"
      ],
      "properties": {
        "schema_version": {
          "const": "phase21-scientific-evidence-qualification-1.0"
        },
        "status": {
          "const": "qualified"
        },
        "scientific_input_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "source_bundle_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "source_check_receipt_sha256": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "review_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "parser_evaluation_disposition_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        },
        "parser_evaluation_requirement_satisfied": {
          "const": false
        },
        "scientific_completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "bounded_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_limits",
            "gap_dispositions"
          ],
          "properties": {
            "source_limits": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "gap_dispositions": {
              "$ref": "#/$defs/review/properties/gap_dispositions"
            }
          }
        },
        "qualification_fingerprint": {
          "$ref": "whole-paper#/$defs/hash"
        }
      }
    }
  }
}
