{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase21/gold-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gold_manifest_id", "input_fingerprint", "source_document_map", "independence",
    "scope", "items", "metadata"
  ],
  "properties": {
    "schema_version": { "const": "phase21-gold-manifest-1.0" },
    "gold_manifest_id": { "$ref": "#/$defs/sha256" },
    "input_fingerprint": { "$ref": "#/$defs/sha256" },
    "source_document_map": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceDocument" } },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_method", "parser_output_access", "author_id", "approval_id", "approval_status"],
      "properties": {
        "authoring_method": { "const": "manual_independent" },
        "parser_output_access": { "const": "not_used" },
        "author_id": { "type": "string", "minLength": 1 },
        "approval_id": { "type": "string", "minLength": 1 },
        "approval_status": { "const": "approved" }
      }
    },
    "scope": { "enum": ["complete", "incomplete"] },
    "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/item" } },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_refs", "evidence_tier"],
      "properties": {
        "requirement_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence_tier": { "enum": ["offline_fixture", "human_gold"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page_number", "page_status", "source_block_id"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "page_number": { "type": "integer", "minimum": 1 },
        "page_status": { "const": "known" },
        "source_block_id": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "role", "critical", "availability", "source_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["main", "attachment"] },
        "critical": { "type": "boolean" },
        "availability": { "enum": ["available", "missing"] },
        "source_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "document_id", "locator", "category", "centrality",
        "expected_semantic_unit", "independent_input_fingerprint", "author_status", "approval_status"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "locator": { "$ref": "#/$defs/locator" },
        "category": { "enum": ["text", "table", "formula", "citation", "figure", "attachment", "locator"] },
        "centrality": { "enum": ["central", "noncentral"] },
        "expected_semantic_unit": { "type": "string", "minLength": 1 },
        "independent_input_fingerprint": { "$ref": "#/$defs/sha256" },
        "author_status": { "const": "independently_authored" },
        "approval_status": { "const": "approved" }
      }
    }
  }
}
