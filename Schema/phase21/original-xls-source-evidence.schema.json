              "xf_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "reader_cell_type": {
            "enum": [
              "reader_empty",
              "text",
              "number",
              "date_serial",
              "boolean",
              "error",
              "formatted_blank"
            ]
          }
        }
      }
