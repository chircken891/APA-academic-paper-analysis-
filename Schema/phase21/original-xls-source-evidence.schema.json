          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "bytes_base64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 134217728
            }
          }
        },
