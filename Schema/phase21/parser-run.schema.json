{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase21/parser-run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "parser_run_id", "sources", "backend", "backend_version",
    "normalization_version", "config_fingerprint", "approval_fingerprint", "approval_scope",
    "blocks", "page_coverage", "assets", "normalization_audit", "resource_observations",
    "errors", "candidate_eligibility", "metadata"
  ],
  "properties": {
    "schema_version": { "const": "phase21-parser-run-1.0" },
    "parser_run_id": { "$ref": "#/$defs/sha256" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "backend": { "type": "string", "minLength": 1 },
    "backend_version": { "type": "string", "minLength": 1 },
    "normalization_version": { "type": "string", "minLength": 1 },
    "config_fingerprint": { "$ref": "#/$defs/sha256" },
    "approval_fingerprint": { "$ref": "#/$defs/sha256" },
    "approval_scope": { "type": "string", "minLength": 1 },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "page_coverage": { "type": "array", "items": { "$ref": "#/$defs/pageCoverage" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "normalization_audit": { "type": "object", "additionalProperties": false, "required": ["mappings", "raw_page_policy"], "properties": { "mappings": { "type": "array", "items": { "$ref": "#/$defs/audit" } }, "raw_page_policy": { "const": "preserve_unknown_before_v2_normalization" } } },
    "resource_observations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "status"], "properties": { "kind": { "type": "string", "minLength": 1 }, "status": { "enum": ["not_invoked", "observed"] }, "detail": { "type": "string" }, "value": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "unit": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "status": { "const": "observed" } } }, "then": { "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "type": "string", "minLength": 1 } }, "required": ["value", "unit"] }, "else": { "properties": { "value": { "type": "null" } } } }] } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "candidate_eligibility": { "type": "object", "additionalProperties": false, "required": ["eligible", "blockers"], "properties": { "eligible": { "type": "boolean" }, "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["requirement_refs"], "properties": { "requirement_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["document_id", "role", "critical", "availability", "source_sha256"], "properties": { "document_id": { "type": "string", "minLength": 1 }, "role": { "enum": ["main", "attachment"] }, "critical": { "type": "boolean" }, "availability": { "enum": ["available", "missing"] }, "source_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] } } },
    "locator": { "type": "object", "additionalProperties": false, "required": ["document_id", "page_number", "page_status", "source_block_id"], "properties": { "document_id": { "type": "string", "minLength": 1 }, "page_number": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "page_status": { "enum": ["known", "unknown"] }, "source_block_id": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "page_status": { "const": "known" } } }, "then": { "properties": { "page_number": { "type": "integer", "minimum": 1 } } }, "else": { "properties": { "page_number": { "type": "null" } } } }] },
    "block": { "type": "object", "additionalProperties": false, "required": ["id", "type", "text", "locator", "rotation_degrees"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "enum": ["paragraph", "heading", "table", "figure", "equation", "reference", "metadata"] }, "text": { "type": "string" }, "locator": { "$ref": "#/$defs/locator" }, "rotation_degrees": { "type": "number" }, "formula": { "type": "object", "additionalProperties": false, "required": ["confidence", "disposition", "symbol"], "properties": { "confidence": { "enum": ["high", "low", "unknown"] }, "disposition": { "enum": ["claimed", "unresolved", "rejected"] }, "symbol": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] } } }, "table_links": { "type": "object", "additionalProperties": false, "properties": { "header_locator": { "$ref": "#/$defs/locator" }, "footnote_locator": { "$ref": "#/$defs/locator" } } } } },
    "pageCoverage": { "type": "object", "additionalProperties": false, "required": ["document_id", "known_pages", "unknown_item_count"], "properties": { "document_id": { "type": "string", "minLength": 1 }, "known_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }, "unknown_item_count": { "type": "integer", "minimum": 0 } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["asset_id", "status"], "properties": { "asset_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["resolved", "unresolved"] }, "locator": { "$ref": "#/$defs/locator" }, "unresolved_reason": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "status": { "const": "resolved" } } }, "then": { "properties": { "locator": {} }, "required": ["locator"] }, "else": { "properties": { "unresolved_reason": {} }, "required": ["unresolved_reason"] } }] },
    "audit": { "type": "object", "additionalProperties": false, "required": ["document_id", "source_item_index", "disposition"], "properties": { "document_id": { "type": "string", "minLength": 1 }, "source_item_index": { "type": "integer", "minimum": 0 }, "disposition": { "enum": ["retained", "unknown_page", "unresolved_formula"] } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "document_id"], "properties": { "code": { "enum": ["UNKNOWN_RAW_PAGE", "MISSING_CRITICAL_INPUT", "MISSING_CRITICAL_PARSE", "UNRESOLVED_FORMULA", "UNRESOLVED_ASSET", "UNRESOLVED_TABLE_LINK"] }, "document_id": { "type": "string", "minLength": 1 }, "source_block_id": { "type": "string", "minLength": 1 }, "reference_kind": { "enum": ["header", "footnote"] }, "referenced_block_id": { "type": "string", "minLength": 1 } } }
  }
}
