{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase21/accepted-reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "reference_manifest_id", "input_fingerprint", "source_document_map",
    "acceptance", "method", "scope", "items"
  ],
  "properties": {
    "schema_version": { "const": "phase21-accepted-reference-1.0" },
    "reference_manifest_id": { "$ref": "gold-manifest#/$defs/sha256" },
    "input_fingerprint": { "$ref": "gold-manifest#/$defs/sha256" },
    "source_document_map": { "type": "array", "minItems": 1, "items": { "$ref": "gold-manifest#/$defs/sourceDocument" } },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_ref", "corpus_id", "paper_id", "record_ref", "record_fingerprint"],
      "properties": {
        "decision_ref": { "const": "D-21-35" },
        "corpus_id": { "const": "phase21-twelve-paper" },
        "paper_id": { "enum": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"] },
        "record_ref": { "type": "string", "minLength": 1 },
        "record_fingerprint": { "$ref": "gold-manifest#/$defs/sha256" }
      }
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["preparation", "verification", "source_access", "parser_output_access", "independence"],
      "properties": {
        "preparation": { "const": "assisted" },
        "verification": { "enum": ["user_and_assisted", "assisted"] },
        "source_access": { "enum": ["used", "not_used", "unknown"] },
        "parser_output_access": { "enum": ["unknown", "used", "not_used"] },
        "independence": { "const": "nonblind" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "category_dispositions", "uncovered_items"],
      "properties": {
        "status": { "enum": ["complete", "incomplete"] },
        "category_dispositions": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/categoryDisposition" } },
        "uncovered_items": { "type": "array", "items": { "$ref": "#/$defs/uncoveredItem" } }
      }
    },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "category": { "enum": ["text", "table", "formula", "citation", "figure", "attachment", "locator"] },
    "categoryDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "disposition", "reason"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "disposition": { "enum": ["covered", "inapplicable", "uncovered"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "uncoveredItem": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "category", "reason"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidence_id", "document_id", "locator", "category", "centrality", "expected_semantic_unit",
        "source_record_ref", "source_record_revision", "source_record_fingerprint",
        "preparation", "verification", "source_access", "parser_output_access"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "locator": { "$ref": "gold-manifest#/$defs/locator" },
        "category": { "$ref": "#/$defs/category" },
        "centrality": { "enum": ["central", "noncentral"] },
        "expected_semantic_unit": { "type": "string", "minLength": 1 },
        "source_record_ref": { "type": "string", "minLength": 1 },
        "source_record_revision": { "type": "string", "minLength": 1 },
        "source_record_fingerprint": { "$ref": "gold-manifest#/$defs/sha256" },
        "preparation": { "const": "assisted" },
        "verification": { "enum": ["user_and_assisted", "assisted"] },
        "source_access": { "enum": ["used", "not_used", "unknown"] },
        "parser_output_access": { "enum": ["unknown", "used", "not_used"] }
      }
    }
  }
}
