{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase21/native-workbook",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdfSource"
        },
        {
          "$ref": "#/$defs/workbookSource"
        }
      ]
    },
    "locator": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdfLocator"
        },
        {
          "$ref": "#/$defs/workbookLocator"
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/pdfBlock"
        },
        {
          "$ref": "#/$defs/workbookBlock"
        }
      ]
    },
    "pageCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "known_pages",
        "unknown_item_count"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "known_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "unknown_item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "status"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "unresolved_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "locator": {}
            },
            "required": [
              "locator"
            ]
          },
          "else": {
            "properties": {
              "unresolved_reason": {}
            },
            "required": [
              "unresolved_reason"
            ]
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "source_item_index",
        "disposition"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_item_index": {
          "type": "integer",
          "minimum": 0
        },
        "disposition": {
          "enum": [
            "retained",
            "unknown_page",
            "unresolved_formula"
          ]
        },
        "original_item_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "document_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_block_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_kind": {
          "enum": [
            "header",
            "footnote"
          ]
        },
        "referenced_block_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_row",
        "start_column",
        "end_row",
        "end_column"
      ],
      "properties": {
        "start_row": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_row": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pdfLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "page_number",
        "page_status",
        "source_block_id",
        "kind"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "page_status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "source_block_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "pdf"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "page_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "page_number": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "page_number": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "workbookLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document_id",
        "source_block_id",
        "member_path",
        "sheet",
        "range"
      ],
      "properties": {
        "kind": {
          "const": "workbook"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_block_id": {
          "type": "string",
          "minLength": 1
        },
        "member_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "$ref": "#/$defs/sheet"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "pdfSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "role",
        "critical",
        "availability",
        "source_sha256",
        "kind"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "main",
            "attachment"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "source_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "pdf"
        }
      }
    },
    "workbookSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "role",
        "critical",
        "availability",
        "source_sha256",
        "kind",
        "format",
        "container",
        "member_path"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "main",
            "attachment"
          ]
        },
        "critical": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "source_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "workbook"
        },
        "format": {
          "enum": [
            "xls",
            "xlsx"
          ]
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "document_id",
            "sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "archive",
                "direct"
              ]
            },
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "member_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "state",
        "value",
        "formula",
        "cached_value_status"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "value",
            "blank",
            "error"
          ]
        },
        "value": {
          "anyOf": [{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]
        },
        "formula": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_value_status": {
          "enum": [
            "not_formula",
            "observed",
            "missing"
          ]
        }
      }
    },
    "contextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "locators",
        "reason"
      ],
      "properties": {
        "applicability": {
          "enum": [
            "required",
            "inapplicable"
          ]
        },
        "locators": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/workbookLocator"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "row_labels",
        "units",
        "footnotes"
      ],
      "properties": {
        "headers": {
          "$ref": "#/$defs/contextEntry"
        },
        "row_labels": {
          "$ref": "#/$defs/contextEntry"
        },
        "units": {
          "$ref": "#/$defs/contextEntry"
        },
        "footnotes": {
          "$ref": "#/$defs/contextEntry"
        }
      }
    },
    "pdfBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "locator",
        "rotation_degrees"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "table",
            "figure",
            "equation",
            "reference",
            "metadata"
          ]
        },
        "text": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/pdfLocator"
        },
        "rotation_degrees": {
          "type": "number"
        },
        "formula": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confidence",
            "disposition",
            "symbol"
          ],
          "properties": {
            "confidence": {
              "enum": [
                "high",
                "low",
                "unknown"
              ]
            },
            "disposition": {
              "enum": [
                "claimed",
                "unresolved",
                "rejected"
              ]
            },
            "symbol": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "table_links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "header_locator": {
              "$ref": "#/$defs/locator"
            },
            "footnote_locator": {
              "$ref": "#/$defs/locator"
            }
          }
        }
      }
    },
    "workbookBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "locator",
        "rotation_degrees",
        "cells",
        "context_bindings",
        "merged_ranges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "table"
        },
        "text": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/workbookLocator"
        },
        "rotation_degrees": {
          "const": 0
        },
        "cells": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "context_bindings": {
          "$ref": "#/$defs/context"
        },
        "merged_ranges": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/range"
          }
        }
      }
    },
    "requiredRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "range",
        "purpose",
        "context_bindings"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "context_bindings": {
          "$ref": "#/$defs/context"
        }
      }
    },
    "requiredSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "disposition",
        "reason",
        "ranges"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "required",
            "out_of_scope"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ranges": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/requiredRange"
          }
        },
        "empty_sheet_check": {
          "type": "boolean"
        }
      }
    },
    "requiredCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_id",
            "kind",
            "required_pages"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "pdf"
            },
            "required_pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_id",
            "kind",
            "sheets"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "workbook"
            },
            "sheets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/requiredSheet"
              }
            }
          }
        }
      ]
    },
    "rangeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "range",
        "status",
        "cells_observed",
        "blank_count",
        "error_count"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "status": {
          "enum": [
            "read",
            "unread",
            "read_failed",
            "unsupported",
            "missing"
          ]
        },
        "cells_observed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "blank_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "emptyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observation_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "not_performed"
          ]
        },
        "observation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sheetCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "visibility",
        "status",
        "ranges",
        "empty_check"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "visible",
            "hidden",
            "very_hidden"
          ]
        },
        "status": {
          "enum": [
            "read",
            "unread",
            "empty_sheet",
            "read_failed",
            "unsupported",
            "missing"
          ]
        },
        "ranges": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/rangeCoverage"
          }
        },
        "empty_check": {
          "$ref": "#/$defs/emptyCheck"
        }
      }
    },
    "sourceCoverage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_id",
            "kind",
            "known_pages",
            "unknown_item_count"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "pdf"
            },
            "known_pages": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "unknown_item_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_id",
            "kind",
            "status",
            "sheets"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "workbook"
            },
            "status": {
              "enum": [
                "read",
                "unread",
                "read_failed",
                "unsupported",
                "missing"
              ]
            },
            "sheets": {
              "type": "array",
              "minItems": 0,
              "items": {
                "$ref": "#/$defs/sheetCoverage"
              }
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "format",
        "status",
        "reader",
        "observation_ref"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "xls",
            "xlsx"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "observation_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "parser_run_id",
        "sources",
        "backend",
        "backend_version",
        "normalization_version",
        "config_fingerprint",
        "approval_fingerprint",
        "approval_scope",
        "blocks",
        "assets",
        "normalization_audit",
        "resource_observations",
        "errors",
        "candidate_eligibility",
        "metadata",
        "source_coverage",
        "required_coverage",
        "required_coverage_fingerprint",
        "observation_fingerprint",
        "capabilities"
      ],
      "properties": {
        "schema_version": {
          "const": "phase21-parser-run-workbook-1.0"
        },
        "parser_run_id": {
          "$ref": "#/$defs/sha256"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "backend_version": {
          "type": "string",
          "minLength": 1
        },
        "normalization_version": {
          "type": "string",
          "minLength": 1
        },
        "config_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "approval_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "approval_scope": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "normalization_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mappings",
            "raw_page_policy"
          ],
          "properties": {
            "mappings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/audit"
              }
            },
            "raw_page_policy": {
              "const": "preserve_unknown_before_v2_normalization"
            }
          }
        },
        "resource_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "not_invoked",
                  "observed"
                ]
              },
              "detail": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "observed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ]
                },
                "else": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "candidate_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible",
            "blockers"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_refs"
          ],
          "properties": {
            "requirement_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "source_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceCoverage"
          }
        },
        "required_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requiredCoverage"
          }
        },
        "required_coverage_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "observation_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "capabilities": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "category": {
      "enum": [
        "text",
        "table",
        "formula",
        "citation",
        "figure",
        "attachment",
        "locator"
      ]
    },
    "categoryDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "disposition",
        "reason"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category"
        },
        "disposition": {
          "enum": [
            "covered",
            "inapplicable",
            "uncovered"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncoveredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "category",
        "reason"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "document_id",
        "locator",
        "category",
        "centrality",
        "expected_semantic_unit",
        "source_record_ref",
        "source_record_revision",
        "source_record_fingerprint",
        "preparation",
        "verification",
        "source_access",
        "parser_output_access"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "centrality": {
          "enum": [
            "central",
            "noncentral"
          ]
        },
        "expected_semantic_unit": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_record_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_record_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "preparation": {
          "const": "assisted"
        },
        "verification": {
          "enum": [
            "user_and_assisted",
            "assisted"
          ]
        },
        "source_access": {
          "enum": [
            "used",
            "not_used",
            "unknown"
          ]
        },
        "parser_output_access": {
          "enum": [
            "unknown",
            "used",
            "not_used"
          ]
        },
        "expected_cells": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "context_bindings": {
          "$ref": "#/$defs/context"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "locator": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "workbook"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {"expected_cells":{},"context_bindings":{}},
            "required": [
              "expected_cells",
              "context_bindings"
            ]
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reference_manifest_id",
        "input_fingerprint",
        "source_document_map",
        "acceptance",
        "method",
        "scope",
        "items",
        "required_coverage"
      ],
      "properties": {
        "schema_version": {
          "const": "phase21-accepted-reference-workbook-1.0"
        },
        "reference_manifest_id": {
          "$ref": "#/$defs/sha256"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "source_document_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_ref",
            "corpus_id",
            "paper_id",
            "record_ref",
            "record_fingerprint"
          ],
          "properties": {
            "decision_ref": {
              "const": "D-21-35"
            },
            "corpus_id": {
              "const": "phase21-twelve-paper"
            },
            "paper_id": {
              "enum": [
                "01",
                "02",
                "03",
                "04",
                "05",
                "06",
                "07",
                "08",
                "09",
                "10",
                "11",
                "12"
              ]
            },
            "record_ref": {
              "type": "string",
              "minLength": 1
            },
            "record_fingerprint": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preparation",
            "verification",
            "source_access",
            "parser_output_access",
            "independence"
          ],
          "properties": {
            "preparation": {
              "const": "assisted"
            },
            "verification": {
              "enum": [
                "user_and_assisted",
                "assisted"
              ]
            },
            "source_access": {
              "enum": [
                "used",
                "not_used",
                "unknown"
              ]
            },
            "parser_output_access": {
              "enum": [
                "unknown",
                "used",
                "not_used"
              ]
            },
            "independence": {
              "const": "nonblind"
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "category_dispositions",
            "uncovered_items"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "incomplete"
              ]
            },
            "category_dispositions": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/categoryDisposition"
              }
            },
            "uncovered_items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uncoveredItem"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "required_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requiredCoverage"
          }
        }
      }
    }
  }
}
